# zecurity-dns-helper.service — ADR-023 option C
#
# Runs as root: per-link DNS configuration is polkit-gated behind auth_admin, and
# capabilities do not help because polkit authorizes on uid.
#
# @ALLOW_UID@ is substituted by the install script with the uid of the enrolling user
# — the same user the client daemon's `User=` is set to. Getting it wrong either locks
# out the daemon or widens access, so there is deliberately no default.

[Unit]
Description=Zecurity DNS helper
Documentation=https://github.com/vairabarath/zecurity
Requires=zecurity-dns-helper.socket
After=systemd-resolved.service
# resolvectl is the only host interface this uses; without resolved there is nothing
# to configure, so do not start pointlessly.
Requires=systemd-resolved.service

[Service]
Type=simple
ExecStart=/usr/local/bin/zecurity-dns-helper --allow-uid @ALLOW_UID@

# Hardening. Root is required for resolved, but nothing else is:
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
# It writes no files at all — it only talks to resolved over D-Bus via resolvectl.
ReadWritePaths=

[Install]
WantedBy=multi-user.target
