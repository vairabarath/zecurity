# Connector BUILD-TIME settings. Copy to connector/.env (gitignored) and run
# `cargo build`: connector/build.rs bakes these values into the binary. They
# are NOT read at runtime and can't be changed through
# /etc/zecurity/connector.conf; rebuild to change them.
#
# Precedence at build time: an environment variable of the same name >
# connector/.env > the built-in default (the values shown below). An
# out-of-range value fails the build.

# ── Connector revocation timing (decided 2026-10-21 from the Phase M
#    measurements, design D13–D15; used from Phase B2). The authorization
#    freshness bound H = 15 s is fixed in code (design D1) and is not a setting.

# P — authorization request period (ms). Range 500–14000 (H − 1 s response
# budget). 4500 tolerates two consecutive lost requests before the deadline.
AUTHZ_REQUEST_PERIOD_MS=4500

# O5 — Control-stream reconnect backoff while not serving. Starts at BASE,
# doubles per failure up to MAX, ±JITTER_PCT; resets after a session gets an
# accepted authorization ack. Ranges: 100 ≤ BASE ≤ MAX ≤ 60000; jitter 0–50.
CONTROL_RECONNECT_BASE_MS=1000
CONTROL_RECONNECT_MAX_MS=5000
CONTROL_RECONNECT_JITTER_PCT=20

# O8 — while temporarily Disabled the connector keeps shield streams, relay
# attachment and client connections open but carries no traffic; after this
# many seconds in Disabled it closes the shield streams so shields fail over.
# Range 1–3600.
DISABLED_SHIELD_CLOSE_SECS=30
