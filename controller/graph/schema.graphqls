scalar Time

# controller/graph/schema.graphqls — Sprint 1 types

# Restricts a field to callers whose LIVE workspace role (users.role, looked up
# per request; PENDING-19 §5) holds `capability`. Enforced in the GraphQL
# execution layer (see resolvers.Requires); REST routes use the same check via
# middleware.RequireCapability. The JWT role claim is display-only and is never
# read for authorization. The role → capability table lives in internal/rbac.
directive @requires(capability: Capability!) on FIELD_DEFINITION

# gqlgen built-in: forces a field to be resolved by a hand-written resolver method
# instead of reading a matching struct field directly off the parent Go model.
directive @goField(forceResolver: Boolean, name: String) on FIELD_DEFINITION | INPUT_FIELD_DEFINITION

type Query {
  # Returns the currently authenticated user.
  # Requires valid JWT in Authorization header.
  me: User!

  # Returns all active users in the current workspace.
  # Scoped to tenant_id from JWT — never crosses workspaces.
  users: [User!]! @requires(capability: CONSOLE_READ)

  # Returns the workspace the current user belongs to.
  # Scoped to tenant_id from JWT — never crosses workspaces.
  workspace: Workspace!

  # Public: Look up a workspace by slug during login/signup.
  # Returns {found: false, workspace: null} if not found (no error).
  # Used by the signup wizard to warn on slug collision.
  lookupWorkspace(slug: String!): WorkspaceLookupResult!

  # Public: List active workspaces a given email has an account in.
  # Used by the login page to let returning users pick a workspace.
  # Scoped by email only — no cross-tenant data exposed.
  lookupWorkspacesByEmail(email: String!): WorkspaceListResult!
}

type Mutation {
  # Step 1 of login: React calls this first.
  # Go generates PKCE pair, stores code_verifier in Redis,
  # builds and returns the Google OAuth redirect URL.
  # workspaceName is optional — set during signup flow, empty during normal login.
  # connectionId is optional — the identity_connections id from the discovery API
  # (GET /workspaces/{slug}/auth); when set it selects that exact connection
  # (Enterprise or Bootstrap). When omitted, the platform IdP for `provider` is
  # resolved. It is the ONLY connection selector; resolution is server-side.
  initiateAuth(provider: String!, workspaceName: String, connectionId: ID): AuthInitPayload!

  # PENDING-19 §7 — change a workspace member's console role. Admin only.
  # Refused for your own account and when it would leave the workspace with no
  # active Admin. `reason` is required and stored in the audit log only. Applies
  # on the target's next request (live role check); their client is untouched.
  setMemberRole(userId: ID!, role: Role!, reason: String!): User! @requires(capability: MEMBERS_ADMIN)
}

type AuthInitPayload {
  # The full Google OAuth URL React should redirect the browser to.
  redirectUrl: String!
  # The signed state value. React stores this for CSRF verification.
  state:       String!
}

type User {
  id:          ID!
  email:       String!
  role:        Role!
  provider:    String!
  createdAt:   String!

  # --- Provisioning provenance (ADR-025 §4) --------------------------------
  # Two distinct facts, deliberately not collapsed into one:
  #
  # provisionedBy      IMMUTABLE origin recorded at creation: jit | manual | scim
  # provisioningOwner  MUTABLE current authority over directory-owned
  #                    attributes: jit | manual | scim | unmanaged
  #
  # "unmanaged" is an explicit state, NOT inferred from scim_enabled=false — a
  # user whose SCIM connection was removed is unmanaged, and removing a
  # connection never deletes the user.
  #
  # The admin UI MUST derive "managed by the directory" from provisioningOwner
  # == "scim" and disable directory-owned fields on that basis — never guess it
  # from `provider`.
  provisionedBy:     String!
  provisioningOwner: String!

  # Console capabilities of this user's current role (PENDING-19 §4). The admin
  # UI uses it on `me` to choose what to show; the server still checks every
  # call, so this is never an authorization input.
  capabilities: [Capability!]!
}

type Workspace {
  id:          ID!
  slug:        String!
  name:        String!
  status:      WorkspaceStatus!
  createdAt:   String!
}

# Workspace console roles (PENDING-19 §3). One role per person.
enum Role {
  ADMIN
  VIEWER
  DEVOPS
  SECURITY
  HELPDESK
  MEMBER
}

# Console operation classes (PENDING-19 §4). Values equal internal/rbac.Capability.
enum Capability {
  CONSOLE_READ
  NETWORK_WRITE
  ACCESS_WRITE
  POSTURE_WRITE
  DEVICE_WRITE
  DEVICE_ADMIN
  IDENTITY_ADMIN
  MEMBERS_ADMIN
}

enum WorkspaceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETED
}

# ============================================================================
# Public workspace lookup types (used by login / signup flows)
# ============================================================================

# Minimal public workspace info — exposed on unauthenticated lookups.
# Does NOT include status or cert material.
type WorkspacePublic {
  id:   ID!
  name: String!
  slug: String!
}

type WorkspaceLookupResult {
  found:     Boolean!
  workspace: WorkspacePublic
}

type WorkspaceListResult {
  workspaces: [WorkspacePublic!]!
}
