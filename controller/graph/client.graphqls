type Invitation {
  id:        ID!
  email:     String!
  status:    String!
  expiresAt: String!
  createdAt: String!
}

type ClientDevice {
  id:           ID!
  userId:       ID!
  name:         String!
  commonName:   String!
  os:           String!
  spiffeId:     String
  certNotAfter: String
  lastSeenAt:   String
  createdAt:    String!
  revokedAt:    String
  # ADR-030: set once an admin approves the device as a company device. A
  # profile requiring zecurity.device.approved admits only approved devices.
  approvedAt:      String
  approvedByEmail: String
}

extend type Query {
  # Returns the caller's enrolled client devices (any authenticated user)
  myDevices: [ClientDevice!]!

  # Admin only — returns all enrolled client devices in the workspace
  clientDevices: [ClientDevice!]! @hasRole(roles: [ADMIN])

  # Returns invitation details by token (public — no auth required)
  invitation(token: String!): Invitation
}

extend type Mutation {
  # Admin only — creates an invitation and sends email to the given address
  createInvitation(email: String!): Invitation! @hasRole(roles: [ADMIN])

  # Admin only — revokes a client device cert. Connector picks up revocation
  # on its next 5-min CRL refresh cycle.
  revokeDevice(deviceId: ID!): Boolean! @hasRole(roles: [ADMIN])

  # Admin only (ADR-030) — marks a device as approved by an admin, or removes
  # the approval. Audited; access is re-evaluated at once. A revoked device
  # can't be approved. Both are no-ops when the device is already in that state.
  approveDevice(deviceId: ID!): ClientDevice! @hasRole(roles: [ADMIN])
  unapproveDevice(deviceId: ID!): ClientDevice! @hasRole(roles: [ADMIN])
}
