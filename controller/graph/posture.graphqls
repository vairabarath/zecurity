enum DeviceProfileMode {
  AUDIT
  ENFORCE
}

enum PostureCheckStatus {
  PASS
  FAIL
  UNSUPPORTED
  UNKNOWN
  ERROR
}

type PostureCheckDescriptor {
  id: String!
  label: String!
  platform: String!
  allowUnsupportedMeaningful: Boolean!
}

type DeviceProfileRequirement {
  id: ID!
  checkId: String!
  allowUnsupported: Boolean!
}

type DeviceProfile {
  id: ID!
  name: String!
  mode: DeviceProfileMode!
  manualTrust: Boolean! @deprecated(reason: "Not enforced. Require the zecurity.device.approved check instead (ADR-030).")
  requirements: [DeviceProfileRequirement!]! @goField(forceResolver: true)
  boundResources: [Resource!]! @goField(forceResolver: true)
}

type DevicePostureObservation {
  checkId: String!
  status: PostureCheckStatus!
  observedAt: String!
  collectorError: String
}

type DevicePostureVisibility {
  deviceId: ID!
  deviceName: String!
  profileId: ID!
  satisfied: Boolean!
  stale: Boolean!
  failureReason: String
  evaluatedAt: String!
  reportReceivedAt: String
  reportAgeSeconds: Int
  observations: [DevicePostureObservation!]!
}


extend type Query {
  supportedPostureChecks: [PostureCheckDescriptor!]! @requires(capability: CONSOLE_READ)
  deviceProfiles: [DeviceProfile!]! @requires(capability: CONSOLE_READ)

  devicePostureVisibility(
    profileId: ID!
  ): [DevicePostureVisibility!]! @requires(capability: CONSOLE_READ)
}

extend type Mutation {
  createDeviceProfile(
    name: String!
    manualTrust: Boolean = true
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  updateDeviceProfileMode(
    id: ID!
    mode: DeviceProfileMode!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  # Deprecated (ADR-030): manualTrust is not enforced; require
  # zecurity.device.approved instead.
  updateDeviceProfileManualTrust(
    id: ID!
    enabled: Boolean!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  addProfileRequirement(
    profileId: ID!
    checkId: String!
    allowUnsupported: Boolean!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  deleteDeviceProfile(
    id: ID!
  ): Boolean! @requires(capability: POSTURE_WRITE)

  removeProfileRequirement(
    profileId: ID!
    checkId: String!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  bindResourceToProfile(
    profileId: ID!
    resourceId: ID!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  unbindResourceFromProfile(
    profileId: ID!
    resourceId: ID!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)
}
