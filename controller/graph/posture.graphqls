enum PostureCheckStatus {
  PASS
  FAIL
  UNSUPPORTED
  UNKNOWN
  ERROR
}

type PostureCheckDescriptor {
  id: String!
  label: String!
  platform: String!
  allowUnsupportedMeaningful: Boolean!
}

type DeviceProfileRequirement {
  id: ID!
  checkId: String!
  allowUnsupported: Boolean!
  # Set only for zecurity.network.country (PENDING-20 G1).
  countries: CountryRule
}

# PENDING-20 G1: ISO 3166-1 alpha-2 codes. Deny wins over allow; an empty allow
# list means "any country not denied". An unknown location never passes.
type CountryRule {
  allow: [String!]!
  deny: [String!]!
}

input CountryRuleInput {
  allow: [String!]!
  deny: [String!]!
}

type DeviceProfile {
  id: ID!
  name: String!
  manualTrust: Boolean! @deprecated(reason: "Not enforced. Require the zecurity.device.approved check instead (ADR-030).")
  requirements: [DeviceProfileRequirement!]! @goField(forceResolver: true)
  # PENDING-16: the resource policies that require this profile.
  policies: [ResourcePolicy!]! @goField(forceResolver: true)
}

# PENDING-16 D-4: what deleting a device profile changed.
type DeviceProfileDeletion {
  # The resource policies the profile was removed from.
  removedFrom: [ResourcePolicyRef!]!
  # Those of them left with no profiles: they now allow any device.
  nowAnyDevice: [ResourcePolicyRef!]!
}

type ResourcePolicyRef {
  id: ID!
  name: String!
}

type DevicePostureObservation {
  checkId: String!
  status: PostureCheckStatus!
  observedAt: String!
  collectorError: String
}

type DevicePostureVisibility {
  deviceId: ID!
  deviceName: String!
  profileId: ID!
  satisfied: Boolean!
  stale: Boolean!
  failureReason: String
  evaluatedAt: String!
  reportReceivedAt: String
  reportAgeSeconds: Int
  observations: [DevicePostureObservation!]!
}


extend type Query {
  supportedPostureChecks: [PostureCheckDescriptor!]! @requires(capability: CONSOLE_READ)
  deviceProfiles: [DeviceProfile!]! @requires(capability: CONSOLE_READ)

  devicePostureVisibility(
    profileId: ID!
  ): [DevicePostureVisibility!]! @requires(capability: CONSOLE_READ)
}

extend type Mutation {
  createDeviceProfile(
    name: String!
    manualTrust: Boolean = true
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  # Deprecated (ADR-030): manualTrust is not enforced; require
  # zecurity.device.approved instead.
  updateDeviceProfileManualTrust(
    id: ID!
    enabled: Boolean!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  addProfileRequirement(
    profileId: ID!
    checkId: String!
    allowUnsupported: Boolean!
    # Required for zecurity.network.country, refused for every other check.
    countries: CountryRuleInput
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  # PENDING-20 G-10: replace the allow/deny lists of a profile's country
  # requirement atomically (no window without a country check).
  updateProfileRequirementCountries(
    profileId: ID!
    countries: CountryRuleInput!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)

  # PENDING-16 D-4: a profile that resource policies use is deleted only with
  # confirmInUse: true; it is then removed from them (a policy left with no
  # profiles allows any device). Without it the request is refused, naming them.
  # The result names the policies it was removed from and those now allowing
  # any device.
  deleteDeviceProfile(
    id: ID!
    confirmInUse: Boolean = false
  ): DeviceProfileDeletion! @requires(capability: POSTURE_WRITE)

  removeProfileRequirement(
    profileId: ID!
    checkId: String!
  ): DeviceProfile! @requires(capability: POSTURE_WRITE)
}
