enum DeviceProfileMode {
  AUDIT
  ENFORCE
}

type PostureCheckDescriptor {
  id: String!
  label: String!
  platform: String!
  allowUnsupportedMeaningful: Boolean!
}

type DeviceProfileRequirement {
  id: ID!
  checkId: String!
  allowUnsupported: Boolean!
}

type DeviceProfile {
  id: ID!
  name: String!
  mode: DeviceProfileMode!
  requirements: [DeviceProfileRequirement!]! @goField(forceResolver: true)
  boundResources: [Resource!]! @goField(forceResolver: true)
}

extend type Query {
  supportedPostureChecks: [PostureCheckDescriptor!]! @hasRole(roles: [ADMIN])
  deviceProfiles: [DeviceProfile!]! @hasRole(roles: [ADMIN])
}

extend type Mutation {
  createDeviceProfile(
    name: String!
  ): DeviceProfile! @hasRole(roles: [ADMIN])

  updateDeviceProfileMode(
    id: ID!
    mode: DeviceProfileMode!
  ): DeviceProfile! @hasRole(roles: [ADMIN])

  addProfileRequirement(
    profileId: ID!
    checkId: String!
    allowUnsupported: Boolean!
  ): DeviceProfile! @hasRole(roles: [ADMIN])

  deleteDeviceProfile(
    id: ID!
  ): Boolean! @hasRole(roles: [ADMIN])

  removeProfileRequirement(
    profileId: ID!
    checkId: String!
  ): DeviceProfile! @hasRole(roles: [ADMIN])

  bindResourceToProfile(
    profileId: ID!
    resourceId: ID!
): DeviceProfile! @hasRole(roles: [ADMIN])

unbindResourceFromProfile(
    profileId: ID!
    resourceId: ID!
): DeviceProfile! @hasRole(roles: [ADMIN])
}
