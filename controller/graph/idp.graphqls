# Identity-provider administration (PENDING-04 Phase 6 / ADR-024).
#
# Workspace admins manage their own (BYO) OIDC connections here. The client
# secret is WRITE-ONLY: it is accepted on create/update but is NEVER returned by
# any query or mutation. Platform (managed) IdPs are not editable through this
# API — they are provider-managed and shared.

enum IdpProtocol {
  OIDC
  SAML
}

type WorkspaceIdpConnection {
  id:           ID!
  protocol:     IdpProtocol!
  provider:     String!
  displayName:  String!
  issuer:       String!
  clientId:     String
  discoveryUrl: String
  scopes:       String!
  domainHint:   String
  status:       String!
  managed:      Boolean!
  # NOTE: clientSecret is intentionally absent — it is never exposed.
}

type ScimToken {
  id: ID!
  workspaceId: ID!
  connectionId: ID!
  label: String
  createdBy: ID
  createdAt: Time!
  lastUsedAt: Time
  expiresAt: Time
  revokedAt: Time
}

type ScimTokenMintResult {
  token: ScimToken!
  plaintext: String!
}

input CreateIdpConnectionInput {
  provider:     String!   # resolver key: "okta", "entra", "oidc", ...
  displayName:  String!
  issuer:       String!   # immutable identity anchor
  clientId:     String!
  clientSecret: String!   # write-only; encrypted at rest
  discoveryUrl: String    # optional; else derived from issuer (.well-known)
  scopes:       String    # default "openid email profile"
  domainHint:   String
}

input UpdateIdpConnectionInput {
  displayName:  String
  clientId:     String
  clientSecret: String    # write-only; omit to keep the existing secret
  discoveryUrl: String
  scopes:       String
  domainHint:   String
}

# Result of a connection reachability + mapping-validation check.
# ADR-025 §3.1: mapping "proven" enables SCIM; "unproven" keeps it disabled
# unless identity.mapping.break_glass overrides.
type IdpTestResult {
  ok:      Boolean!
  issuer:  String
  message: String
  # The active mapping-validation state: "proven" or "unproven" (ADR-025 §3.1).
  # Phase 4 cannot run the real POST→GET→verify→DELETE round-trip (the /Users
  # endpoint lands in Phase 5), so until that probe runs this is always
  # "unproven" and SCIM stays disabled.
  mappingState: String!
  # Whether SCIM provisioning is permitted for this connection after validation.
  # False unless the mapping is proven or an identity.mapping.break_glass
  # override applies.
  scimEnabledAllowed: Boolean!
  # Human-readable explanation of the mapping/validation outcome.
  reason: String
}

extend type Query {
  idpConnections: [WorkspaceIdpConnection!]! @hasRole(roles: [ADMIN])
  # Whether the workspace still offers the shared platform IdP as a login path.
  platformLoginEnabled: Boolean! @hasRole(roles: [ADMIN])

  scimTokens(connectionId: ID!): [ScimToken!]! @hasRole(roles: [ADMIN])
}

extend type Mutation {
  createIdpConnection(input: CreateIdpConnectionInput!): WorkspaceIdpConnection! @hasRole(roles: [ADMIN])
  updateIdpConnection(id: ID!, input: UpdateIdpConnectionInput!): WorkspaceIdpConnection! @hasRole(roles: [ADMIN])
  # status is "active" | "disabled". Disabling revokes the sessions of every user
  # who authenticates through this connection (their login path is gone).
  setIdpConnectionStatus(id: ID!, status: String!): WorkspaceIdpConnection! @hasRole(roles: [ADMIN])
  deleteIdpConnection(id: ID!): Boolean! @hasRole(roles: [ADMIN])
  testIdpConnection(id: ID!): IdpTestResult! @hasRole(roles: [ADMIN])
  # Toggle the shared platform IdP as a login path for this workspace. Disabling
  # is refused if the workspace has no active identity provider of its own and
  # the actor is not a break-glass admin (no-lockout, ADR-024 §5).
  setPlatformLoginEnabled(enabled: Boolean!): Boolean! @hasRole(roles: [ADMIN])

  mintScimToken(
    connectionId: ID!
    label: String
    expiresAt: Time
  ): ScimTokenMintResult! @hasRole(roles: [ADMIN])

  rotateScimToken(
    connectionId: ID!
    label: String
    expiresAt: Time
  ): ScimTokenMintResult! @hasRole(roles: [ADMIN])

  revokeScimToken(
    connectionId: ID!
    tokenId: ID!
  ): Boolean! @hasRole(roles: [ADMIN])

  # Explicit fine-grained permission grant (Phase 3 break-glass primitive).
  # ADMIN may grant, but possession is an explicit row — never implied by role.
  # granted_to receives the permission; grantor is the authenticated admin.
  grantPermission(
    userId: ID!
    permission: String!
  ): WorkspacePermission! @hasRole(roles: [ADMIN])

  # Enable SCIM for a connection despite an unproven identity mapping, using the
  # dedicated identity.mapping.break_glass permission (ADR-025 §3.2). ADMIN role
  # alone is NOT sufficient — the caller must explicitly hold the permission, and
  # a mandatory reason is required. Every invocation is audited as
  # scim.mapping.break_glass_override.
  enableScimBreakGlass(
    connectionId: ID!
    reason: String!
  ): Boolean! @hasRole(roles: [ADMIN])
}

# One explicit (workspace, user, permission) grant. A row existing is the ONLY
# thing that satisfies a permission check — ADMIN role does not.
type WorkspacePermission {
  workspaceId: ID!
  userId: ID!
  permission: String!
  grantedBy: ID
}
