type Resource {
  id:             ID!
  name:           String!
  description:    String
  host:           String!
  protocol:       String!
  portFrom:       Int!
  portTo:         Int!
  status:         String!
  errorMessage:   String
  appliedAt:      String
  lastVerifiedAt: String
  createdAt:      String!
  shield:         Shield         # auto-matched — null if no shield on this host
  remoteNetwork:  RemoteNetwork!
}

input CreateResourceInput {
  remoteNetworkId: String!
  name:            String!
  description:     String
  host:            String!       # IPv4 address of the resource host (resource.NormalizeHost); a shield on it can protect it later
  protocol:        String!       # "tcp", "udp", "any"
  portFrom:        Int!
  portTo:          Int!
}

input UpdateResourceInput {
  remoteNetworkId: String
  name:            String
  description:     String
  host:            String        # IPv4 address (resource.NormalizeHost); protected: must be an active shield's lan_ip (the resource moves to that shield)
  protocol:        String
  portFrom:        Int
  portTo:          Int
}

extend type Query {
  resources(remoteNetworkId: String!): [Resource!]! @requires(capability: CONSOLE_READ)
  allResources: [Resource!]! @requires(capability: CONSOLE_READ)
}

extend type Mutation {
  createResource(input: CreateResourceInput!): Resource! @requires(capability: NETWORK_WRITE)
  updateResource(id: ID!, input: UpdateResourceInput!): Resource! @requires(capability: NETWORK_WRITE)
  protectResource(id: ID!): Resource! @requires(capability: NETWORK_WRITE)
  unprotectResource(id: ID!): Resource! @requires(capability: NETWORK_WRITE)
  deleteResource(id: ID!): Boolean! @requires(capability: NETWORK_WRITE)
  # Break-glass (ADR-004 Phase 4): hard-delete a resource in ANY state, bypassing
  # the confirmation-gated tombstone path. For resources permanently stuck because
  # their shield is gone and will never ack removal. Admin-only and audit-logged.
  forceDeleteResource(id: ID!): Boolean! @requires(capability: NETWORK_WRITE)
}
