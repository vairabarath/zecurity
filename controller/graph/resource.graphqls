type Resource {
  id:             ID!
  name:           String!
  description:    String
  # Pinned IP. Empty string (never null) when the resource is name-addressed —
  # kept non-null so existing clients don't break.
  host:           String!
  # Name-addressed resources (PENDING-14). Null for classic IP-pinned ones.
  hostname:       String
  # Raw resolver JSON as stored, e.g. {"type":"dns","config":{"server":"..."}}.
  # Null unless hostname is set.
  resolver:       String
  # Shield-delivered resources only: the address the shield dials on its own
  # host (127.0.0.1 or its LAN IP).
  localTarget:    String
  protocol:       String!
  portFrom:       Int!
  portTo:         Int!
  status:         String!
  errorMessage:   String
  appliedAt:      String
  lastVerifiedAt: String
  createdAt:      String!
  shield:         Shield         # auto-matched — null if no shield on this host
  remoteNetwork:  RemoteNetwork!
}

input CreateResourceInput {
  remoteNetworkId: String!
  name:            String!
  description:     String
  # Exactly one of host / hostname must be given.
  #   host     — IP of the resource host; must match a shield's lan_ip
  #   hostname — a name the connector resolves at dial time
  # Relaxed from String! to String in Sprint 16; omitting both is rejected by
  # the resolver and, as a backstop, by resources_addressable_check.
  host:            String
  hostname:        String
  # Resolver JSON: a JSON object with a required "type" ("dns" | "static") and
  # an optional "config" object of string values. Only meaningful with hostname.
  resolver:        String
  localTarget:     String
  protocol:        String!       # "tcp", "udp", "any"
  portFrom:        Int!
  portTo:          Int!
}

input UpdateResourceInput {
  remoteNetworkId: String
  name:            String
  description:     String
  hostname:        String
  resolver:        String
  localTarget:     String
  protocol:        String
  portFrom:        Int
  portTo:          Int
}

extend type Query {
  resources(remoteNetworkId: String!): [Resource!]! @hasRole(roles: [ADMIN])
  allResources: [Resource!]! @hasRole(roles: [ADMIN])
}

extend type Mutation {
  createResource(input: CreateResourceInput!): Resource! @hasRole(roles: [ADMIN])
  updateResource(id: ID!, input: UpdateResourceInput!): Resource! @hasRole(roles: [ADMIN])
  protectResource(id: ID!): Resource! @hasRole(roles: [ADMIN])
  unprotectResource(id: ID!): Resource! @hasRole(roles: [ADMIN])
  deleteResource(id: ID!): Boolean! @hasRole(roles: [ADMIN])
  # Break-glass (ADR-004 Phase 4): hard-delete a resource in ANY state, bypassing
  # the confirmation-gated tombstone path. For resources permanently stuck because
  # their shield is gone and will never ack removal. Admin-only and audit-logged.
  forceDeleteResource(id: ID!): Boolean! @hasRole(roles: [ADMIN])
}
