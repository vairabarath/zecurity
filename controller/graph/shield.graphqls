# controller/graph/shield.graphqls — Shield types for Sprint 4

type Shield {
  id:              ID!
  name:            String!
  status:          ShieldStatus!
  remoteNetworkId: ID!
  connectorId:     ID!
  lastSeenAt:      String
  version:         String
  hostname:        String
  lanIp:           String
  interfaceAddr:   String
  certNotAfter:    String
  createdAt:       String!
}

enum ShieldStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  REVOKED
}

type ShieldToken {
  shieldId: ID!
}

extend type Mutation {
  generateShieldToken(remoteNetworkId: ID!, shieldName: String!): ShieldToken! @requires(capability: NETWORK_WRITE)
  revokeShield(id: ID!): Boolean! @requires(capability: NETWORK_WRITE)
  deleteShield(id: ID!): Boolean! @requires(capability: NETWORK_WRITE)
}

extend type Query {
  shields(remoteNetworkId: ID!): [Shield!]! @requires(capability: CONSOLE_READ)
  shield(id: ID!): Shield @requires(capability: CONSOLE_READ)
}
