DATABASE_URL=postgres://ztna:ztna_dev_secret@localhost:5432/ztna_platform?sslmode=disable
# Valkey (open-source Redis-compatible cache, Linux Foundation fork of Redis 7.2)
# Note: URL scheme is "redis://" — that is the wire protocol name, not the product.
#       The value redis://localhost:6379 is correct even when using Valkey.
VALKEY_URL=redis://localhost:6379
PORT=8080
ENV=development

JWT_SECRET=replace_with_32_plus_random_bytes

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Separate OAuth app for the Rust CLI — web application type in Google Console.
# Register http://localhost:8080/api/clients/callback as an authorised redirect URI.
# In production: https://your-controller.example.com/api/clients/callback
CLIENT_GOOGLE_CLIENT_ID=your_client_app_google_client_id
CLIENT_GOOGLE_CLIENT_SECRET=your_client_app_google_client_secret

PKI_MASTER_SECRET=replace_with_64_plus_random_bytes

ALLOWED_ORIGIN=http://localhost:5173

# ── Connector / Shield install command addresses ────────────────────────────
# These values are embedded into generated connector/shield install commands.
# In production, use the public controller DNS names that match the controller
# certificate SANs. If these are left as localhost, the controller falls back to
# a detected LAN/raw IP for install commands.
CONTROLLER_ADDR=controller.zecurity.in:9090
CONTROLLER_HTTP_ADDR=https://controller.zecurity.in

# ── Connector sprint additions ───────────────────────────────────────────────
GRPC_PORT=9090
CONNECTOR_CERT_TTL=168h
CONNECTOR_ENROLLMENT_TOKEN_TTL=24h
CONNECTOR_HEARTBEAT_INTERVAL=30s
CONNECTOR_DISCONNECT_THRESHOLD=90s
CONNECTOR_RENEWAL_WINDOW=48h

# ── Shield sprint additions ──────────────────────────────────────────────────
SHIELD_CERT_TTL=168h
SHIELD_RENEWAL_WINDOW=48h
SHIELD_ENROLLMENT_TOKEN_TTL=24h
SHIELD_DISCONNECT_THRESHOLD=120s

# ── Client / Invitation sprint additions ────────────────────────────────────
APP_BASE_URL=https://app.zecurity.example.com
CONTROLLER_HOST=controller.zecurity.in:9090
CONTROLLER_HTTP_URL=https://controller.zecurity.in

# SMTP — leave unset in dev mode (invite links are logged to stdout instead)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_PASSWORD=replace_with_smtp_password

# Additional fields from .env
PKI_TEST_DATABASE_URL=postgres://ztna:ztna_dev_secret@localhost:5432/postgres?
sslmode=disable
PROVIDER_BOOTSTRAP_EMAILS=
PROVIDER_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
POSTURE_RETENTION_DAYS=30
POSTURE_RETENTION_BATCH_SIZE=2000

sudo CONTROLLER_ADDR=192.168.1.164:9090 \
     CONTROLLER_HTTP_ADDR=192.168.1.164:8080 \
     ENROLLMENT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..aTZFYnYj8EDfbh6ev2JhTuQ29_66ius1_4rdNz6PcGs \
     ./scripts/connector-local-install.sh /home/inkyank-01/zecurity/connector/target/debug/zecurity-connector
